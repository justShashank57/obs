# --- Server ---
NODE_ENV=development
PORT=4000
# Required in production (server refuses to start without it there). In dev,
# a random ephemeral secret is generated automatically if left blank.
SESSION_SECRET=

# Per-client control panel passwords are generated automatically at boot and
# logged once (see server logs / integrationStatus) — there is no more single
# shared CONTROL_PANEL_PASSWORD. Set this if you also want one operator/admin
# login that can access every client's control panel:
ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call the API with credentials.
# Leave blank to only allow same-origin requests (recommended default).
CORS_ORIGIN=

# --- Twitch (leave blank to run in mock/demo mode) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
# Required for automatic token refresh — without this, the access token above
# will expire in a few hours and alerts will silently stop. Get a refresh
# token the same place you got the access token (Twitch OAuth authorization
# code flow with offline access).
TWITCH_REFRESH_TOKEN=
TWITCH_BROADCASTER_USER_ID=
# Follow events require moderator:read:followers scope + moderator user id (Twitch API change, 2023+).
TWITCH_MODERATOR_USER_ID=

# Read-only chat feed for the Chat Overlay widget (no OAuth needed to read public chat)
TWITCH_CHANNEL_NAME=

# --- YouTube (leave blank to run in mock/demo mode) ---
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLL_INTERVAL_MS=10000

# --- Horizontal scaling (optional) ---
# Set on every process to share sockets/events across more than one server
# process/host. Pair with INTEGRATIONS_ENABLED=false on all but one process
# so Twitch/YouTube/chat connections per client aren't opened redundantly.
REDIS_URL=
INTEGRATIONS_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
